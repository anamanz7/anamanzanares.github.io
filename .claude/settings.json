      "Read(//opt/homebrew/bin/**)",
      "Bash(GIT_ASKPASS=echo git push origin main)",
      "Bash(security dump-keychain *)",
      "Bash(ssh-add -l)",
      "Bash(git fetch *)",
      "Bash(GIT_TRACE=1 GIT_CURL_VERBOSE=1 git push origin main)",
