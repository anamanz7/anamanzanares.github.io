      "Bash(sips -Z 1920 --setProperty formatOptions 80 \"/Users/anamanzanaresgonzalez/anamanzanares.github.io/PORTFOLIO/MAS-CREATION/images/1 NOCHE.jpg\")",
      "Bash(sips --setProperty format jpeg --setProperty formatOptions 82 \"/Users/anamanzanaresgonzalez/anamanzanares.github.io/PORTFOLIO/ECI/mijas/dormitorio-ppal.png\" --out \"/Users/anamanzanaresgonzalez/anamanzanares.github.io/PORTFOLIO/ECI/mijas/dormitorio-ppal.jpg\")",
